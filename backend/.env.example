MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=memoryos
MEMORYOS_ALLOWED_ORIGINS=http://localhost:5173
# Models download once on first use, then run locally.
MEMORYOS_ENABLE_VISION_MODEL=1
MEMORYOS_VISION_MODEL=Salesforce/blip-image-captioning-base
MEMORYOS_ENABLE_CLIP=1
MEMORYOS_CLIP_MODEL=ViT-B-32
MEMORYOS_CLIP_PRETRAINED=laion2b_s34b_b79k
MEMORYOS_OCR_LANGUAGE=en
MEMORYOS_TEXT_WEIGHT=0.6
MEMORYOS_SEMANTIC_WEIGHT=0.4
MEMORYOS_OWNER_ID=local-user
